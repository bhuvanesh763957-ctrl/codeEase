# ==============================================================================
# CodeEase Environment Configuration (.env.example)
# Copy this file to .env or configure in your hosting platform / AI Studio secrets.
# ==============================================================================

# Application URL
APP_URL="http://localhost:3000"
PORT=3000

# Supabase Configuration
# Required for user authentication, PostgreSQL database, and RLS policies.
# Find these in your Supabase project settings -> API.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-keep-secret"

# Frontend Vite equivalents (can mirror SUPABASE_URL & ANON_KEY)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Judge0 Code Execution API Configuration
# Code execution requests are proxied securely through the backend.
# Public instances: https://ce.judge0.com or RapidAPI Judge0 endpoint.
# If left empty, CodeEase will display a clear "Compiler not configured" message.
JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_API_KEY=""
JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"
